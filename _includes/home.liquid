<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Mind Swamp</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <h1>{{ pageTitle }}</h1>
    <h3><em>{{ subtitle }}</em></h3>

    <h2><em>Quote of the Day</em></h2>
    <blockquote>
    <p>&quot;<em>{{ quoteOfTheDay }}</em>&quot;</p>
    <p>–{{ quoteSource }}</p>
    </blockquote>
    
    {{ content }}
</body>