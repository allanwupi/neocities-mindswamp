<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mind Swamp</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <h1>{{ pageTitle }}</h1>
    <h3><em>{{ subtitle }}</em></h3>

    <hr>

    <h2><em>My Current Obsessions</em></h2>
    <ul>
        <li>Reading: <em>{{ currentlyReading }}</em> </li>
        <li>Watching: <em>{{ currentlyWatching }}</em> </li>
        <li>Playing: <em>{{ currentlyPlaying }}</em> </li>
    </ul>

    <h2><em>Quote of the Week</em></h2>
    <blockquote>
    <p>&quot;<em>{{ quoteText }}</em>&quot;</p>
    <p>–{{ quoteSource }}</p>
    </blockquote>

    <hr>
    
    {{ content }}

    <hr>
    
    <footer>
        <em>Last updated: {{ page.date | date: "%Y-%m-%d" }}</em>
    </footer>
</body>